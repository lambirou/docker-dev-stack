TRAEFIK_MANAGER_ADMIN_PASSWORD=change-me

TINYAUTH_PORT=8084
# URL publique de la page de connexion, et domaine du cookie de session. Sans les
# entrees .test dans le fichier hosts, mettre https://auth.localhost a la place.
TINYAUTH_APP_URL=https://auth.test
# Compte local de tinyauth, au format utilisateur:hash bcrypt. Les $ sont doubles
# parce que docker compose les interprete. Valeur livree : dev / devauthpass.
# Regenerer apres un changement de mot de passe :
#   docker compose run --rm tinyauth user create --interactive
TINYAUTH_AUTH_USERS=dev:$$2a$$10$$G4W7QvUocHWPuABT3VA.VeNo5WP5UHktZwT3YUXmBUmGDCcULQvL.
# Lues uniquement par le portail, pour afficher les identifiants en clair. Elles
# doivent decrire le hash ci-dessus : tinyauth, lui, ne lit que TINYAUTH_AUTH_USERS.
TINYAUTH_USER=dev
TINYAUTH_PASSWORD=devauthpass

# Fuseau horaire des conteneurs (Dockhand, Traefik Manager).
TZ=Africa/Abidjan

# Socket du moteur Docker, utilise par Traefik et Dockhand. A laisser vide avec
# Docker Desktop et Docker Engine. A renseigner avec Colima, Rancher Desktop ou
# Podman, par exemple $HOME/.colima/default/docker.sock — scripts/install.sh
# detecte le chemin et ecrit cette ligne tout seul.
DOCKER_SOCKET=
